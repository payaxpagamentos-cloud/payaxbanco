{
  "name": "manager-network",
  "version": "1.0.0",
  "description": "Manager Network — tráfego e Anti-DDoS, rede óptica, Central NOC, chamados técnicos, equipe e comissões, frota, manutenção, abastecimentos e rastreamento para provedores de internet.",
  "main": "server/index.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "migrar": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/migrar.js",
    "demo": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/demo.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "coletor": "node scripts/coletor-exemplo.js",
    "coletor-rede": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/coletor-rede.js",
    "simulador": "node scripts/simulador-fluxos.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3"
  }
}
