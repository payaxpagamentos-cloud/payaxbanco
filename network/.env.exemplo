# Manager Network — copie para .env e ajuste. Em produção (NODE_ENV=production) os três primeiros são obrigatórios.
PORT=3500
# Endereço: https://SEU-DOMINIO/network/  (vazio = raiz do domínio)
NETWORK_BASE_PATH=/network
# Segredo das sessões (mín. 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NETWORK_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
# Chave que cifra as credenciais das integrações no banco (64 caracteres hexadecimais). Não troque depois de salvar credenciais.
NETWORK_CHAVE_CREDENCIAIS=
# Primeiro administrador e a primeira organização, criados no primeiro start (troque a senha ao entrar).
NETWORK_ORGANIZACAO=Minha operação
NETWORK_ADMIN_NOME=Administrador
NETWORK_ADMIN_EMAIL=admin@seu-provedor.com.br
NETWORK_ADMIN_SENHA=troque-esta-senha
# Fuso padrão da operação (cada organização pode mudar em Organização e acessos).
# NETWORK_FUSO=America/Sao_Paulo
# Banco (SQLite) e arquivos privados (comprovantes, fotos, documentos). Faça backup das duas pastas.
# NETWORK_DADOS=./data
# NETWORK_DB=./data/network.db
# NETWORK_ARQUIVOS=./data/arquivos
# NETWORK_ARQUIVO_MAX_MB=10
# Conectores: permitir endereços da rede interna (ex.: rastreador no mesmo servidor em http://127.0.0.1:3400/rastreador).
# Desligado, só destinos públicos são aceitos (proteção contra SSRF). Em produção, http:// só é aceito com esta opção.
# NETWORK_CONECTOR_REDE_INTERNA=1
# NETWORK_CONECTOR_TIMEOUT_MS=10000
# 0 desliga as coletas periódicas (rastreador e Downdetector).
# NETWORK_COLETAS=1
# Mapa: camada de imagens (use um provedor licenciado para o seu volume) e centro inicial.
# NETWORK_MAPA_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
# NETWORK_MAPA_ATRIBUICAO=Mapa &copy; Esri, HERE, Garmin, colaboradores do OpenStreetMap
# NETWORK_MAPA_LAT=-24.0058
# NETWORK_MAPA_LNG=-46.4028
# Atrás de proxy reverso (nginx etc.)
# NETWORK_TRUST_PROXY=loopback
# NETWORK_LIMITE_LOGIN=10
# Coletor de rede (flows e RADIUS). Rode "npm run coletor-rede" (ou NETWORK_COLETOR_EMBUTIDO=1 para rodar dentro do servidor).
# NETWORK_FLUXOS_PORTAS=2055,4739,6343
# NETWORK_RADIUS_PORTA=1813
# NETWORK_FLUXOS_HOST=0.0.0.0
# NETWORK_FLUXOS_BUFFER_MB=32
# NETWORK_COLETOR_EMBUTIDO=0
