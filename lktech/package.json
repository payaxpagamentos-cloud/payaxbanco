{
  "name": "lk-tech-site-gerenciavel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site LK TECH com painel, carrosséis, imagens e conteúdo persistidos em SQLite.",
  "engines": { "node": ">=24.14.0 <25" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
