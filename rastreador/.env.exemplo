# Copie para .env e ajuste. Em produção (NODE_ENV=production), RASTREADOR_SECRET e RASTREADOR_ADMIN_SENHA são obrigatórios.
PORT=3400
# Endereço do painel: https://SEU-DOMINIO/rastreador/  (vazio = raiz do domínio)
RASTREADOR_BASE_PATH=/rastreador
RASTREADOR_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
# Master criado no primeiro acesso
RASTREADOR_ADMIN_NOME=Master
RASTREADOR_ADMIN_EMAIL=master@rastreador.com.br
RASTREADOR_ADMIN_SENHA=troque-esta-senha
# Porta TCP dos rastreadores GT06 (libere no firewall). 0 desliga.
RASTREADOR_GT06_PORTA=5023
# RASTREADOR_DB=./data/rastreador.db
# Fuso das datas do dashboard e dos relatórios
# RASTREADOR_FUSO=America/Sao_Paulo
# Servidor de mapas (padrão: OpenStreetMap) e centro inicial do mapa
# RASTREADOR_MAPA_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# RASTREADOR_MAPA_LAT=-23.5505
# RASTREADOR_MAPA_LNG=-46.6333
# Atrás de proxy reverso (nginx etc.)
# RASTREADOR_TRUST_PROXY=loopback
