# Copie para .env e ajuste. Em produção (NODE_ENV=production), ATEND_SECRET e ATEND_ADMIN_SENHA são obrigatórios.
PORT=3600
# Endereço do painel: https://SEU-DOMINIO/atendimento/  (vazio = raiz do domínio)
ATEND_BASE_PATH=/atendimento
ATEND_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
# Master criado no primeiro acesso
ATEND_ADMIN_NOME=Master
ATEND_ADMIN_EMAIL=master@atendimento.com.br
ATEND_ADMIN_SENHA=troque-esta-senha
# Endereço público: aparece no painel como o callback para colar no app da Meta.
# ATEND_URL_PUBLICA=https://seudominio.com.br
# ATEND_DB=./data/atendimento.db
# Arquivos recebidos no WhatsApp (áudios, fotos, documentos). INCLUA NO BACKUP.
# ATEND_ARQUIVOS=./data/arquivos
# ATEND_ARQUIVO_MAX_MB=16
# Fuso do horário de atendimento, dos dashboards e dos relatórios
# ATEND_FUSO=America/Sao_Paulo
# Atrás de proxy reverso (nginx etc.)
# ATEND_TRUST_PROXY=1

# --- Atendente virtual (Claude API) ---
# Sem a chave, a atendente roda só com as intenções e a base de conhecimento, e oferece o menu de departamentos.
# ATEND_IA_CHAVE=sk-ant-...
# Modelo e esforço de raciocínio. Atendimento de WhatsApp costuma ir bem com 'low'.
# ATEND_IA_MODELO=claude-opus-5-5
# ATEND_IA_ESFORCO=low
# ATEND_IA_MAX_TOKENS=2048
# Quantas idas e voltas de ferramenta a IA pode fazer por mensagem
# ATEND_IA_MAX_PASSOS=6
# ATEND_IA_TIMEOUT_MS=60000

# --- WhatsApp Cloud API (Meta) ---
# O token e o App secret ficam por empresa, no cadastro do número (guardados cifrados).
# ATEND_GRAPH_VERSAO=v23.0
# ATEND_GRAPH_TIMEOUT_MS=20000
# Permite ferramentas da empresa em http:// (só para rede interna; o padrão exige https://)
# ATEND_HTTP=1
