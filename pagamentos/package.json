{
  "name": "payax-pagamentos",
  "version": "1.0.0",
  "description": "PAY AX Pagamentos — emissão de boletos e Bolepix pelo Bradesco, split de pagamento, conta gráfica e repasse automático, com Internet Bank para o cliente final e integração com o IXC.",
  "main": "server/index.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "migrar": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/migrar.js",
    "demo": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/demo.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "empacotar": "bash implantacao/empacotar.sh"
  },
  "dependencies": {
    "express": "^5.2.1",
    "qrcode": "^1.5.4"
  }
}
