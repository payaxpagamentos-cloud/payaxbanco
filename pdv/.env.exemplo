# Copie para .env e ajuste. Em produção (NODE_ENV=production), PDV_SECRET e PDV_ADMIN_SENHA são obrigatórios.
PORT=3600
# Endereço do PDV: https://SEU-DOMINIO/pdv/  (vazio = raiz do domínio)
PDV_BASE_PATH=/pdv
PDV_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
# Master criado no primeiro acesso
PDV_ADMIN_NOME=Master
PDV_ADMIN_EMAIL=master@pdv.com.br
PDV_ADMIN_SENHA=troque-esta-senha
# PDV_DB=./data/pdv.db
# Fuso usado no caixa, nos relatórios e na conferência
# PDV_FUSO=America/Sao_Paulo
# Atrás de proxy reverso (nginx etc.)
# PDV_TRUST_PROXY=loopback
# Permite IXC e maquininha em http:// (só para servidores na rede interna; o padrão exige https://)
# PDV_HTTP=1
# Tempo máximo de espera do IXC e da maquininha (ms)
# PDV_IXC_TIMEOUT=8000
# Quantos minutos o PDV espera a maquininha responder antes de considerar a cobrança expirada
# PDV_CARTAO_EXPIRA_MIN=5
