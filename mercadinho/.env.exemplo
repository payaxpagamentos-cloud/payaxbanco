# Copie para .env e ajuste. Em produção (NODE_ENV=production), MERCADO_SECRET e MERCADO_ADMIN_SENHA são obrigatórios.
PORT=3300
MERCADO_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
MERCADO_ADMIN_EMAIL=admin@mercadinho.com.br
MERCADO_ADMIN_SENHA=troque-esta-senha
MERCADO_ADMIN_NOME=Administração do Mercadinho
# Endereço em que o sistema é publicado (vazio = raiz do domínio)
# MERCADO_BASE_PATH=/mercadinho
# Banco de dados (SQLite). Faça cópia desta pasta.
# MERCADO_DB=./data/mercadinho.db
# Fuso usado no fechamento de caixa, nas competências e nos relatórios
# MERCADO_FUSO=America/Sao_Paulo
# Atrás de proxy reverso (nginx etc.)
# MERCADO_TRUST_PROXY=1
# Tentativas de login por minuto, por IP
# MERCADO_LIMITE_LOGIN=10
# Maquininha de cartão: tempo de espera de cada chamada e minutos até a cobrança pendente expirar
# MERCADO_MAQUININHA_TIMEOUT_MS=8000
# MERCADO_MAQUININHA_EXPIRAR_MIN=5
