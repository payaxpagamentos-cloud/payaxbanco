{
  "name": "play-tech-vip",
  "version": "1.0.0",
  "description": "PLAY TECH VIP — plataforma de streaming: canais de TV ao vivo, catálogo sob demanda, assinaturas e painel de operação.",
  "main": "server/index.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "empacotar": "node scripts/empacotar.js",
    "empacotar-tv": "node scripts/empacotar-tv.js",
    "empacotar-apps": "node scripts/empacotar-apps.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "catalogo-demo": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/catalogo-tmdb.js",
    "catalogo-publico": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/catalogo-publico.js",
    "epg": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/epg-mapear.js",
    "conferir": "bash scripts/conferir-instalacao.sh"
  },
  "dependencies": {
    "express": "^5.2.1",
    "hls.js": "1.6.15",
    "qrcode": "^1.5.4"
  }
}
