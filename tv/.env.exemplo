# Copie para .env e ajuste. Em produção (NODE_ENV=production), TV_SECRET e TV_ADMIN_SENHA são obrigatórios.
PORT=3600
TV_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
TV_ADMIN_EMAIL=admin@playtechvip.com.br
TV_ADMIN_SENHA=troque-esta-senha
# Nome da plataforma nas telas e no PIX
# TV_MARCA=PLAY TECH VIP
# Endereço em que a plataforma é publicada (vazio = raiz do domínio)
# TV_BASE_PATH=/tv
# Banco e arquivos (vídeos, artes e legendas). Inclua a pasta de mídia no backup.
# TV_DB=./data/tv.db
# TV_MIDIA=./data/midia
# Tamanho máximo de cada vídeo e de cada pedaço do envio
# TV_VIDEO_MAX_MB=8192
# TV_UPLOAD_PARTE_MB=8
# Retransmissão dos canais (CDN): 0 desliga e o player vai direto na origem da emissora
# TV_RELAY=1
# Canais que tocam direto na origem precisam do domínio da emissora liberado nas páginas
# TV_ORIGENS_MIDIA=cdn.emissora.com.br,outro.cdn.com.br
# Cobrança: simulado (testes: o assinante confirma na tela) ou manual (a operação confirma o PIX)
# TV_PAGAMENTOS=manual
# Quanto tempo uma tela sem sinal de vida continua ocupando vaga do plano (segundos)
# TV_SESSAO_PLAYER_S=120
# Validade do link de reprodução (segundos)
# TV_PLAY_TTL=21600
# Atrás de proxy reverso (nginx etc.)
# TV_TRUST_PROXY=1
# Fuso dos relatórios e da grade
# TV_FUSO=America/Sao_Paulo

# ---- Produção com docker compose ----
# Domínio em que a plataforma responde (o Caddy emite o certificado HTTPS para ele)
DOMINIO=play.seudominio.com.br
# Quantos núcleos o app pode usar (converter vídeo é o que mais pesa)
# CPUS_APP=2

# Servidor atrás de proxy de saída (comum em empresa): sem isto, o Node não usa o proxy e
# a busca de logos, a lista pública e a grade XMLTV falham.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.empresa.com.br:3128

# ---- Base de filmes e séries (themoviedb.org) ----
# Traz cartaz, banner, sinopse, elenco e classificação dos títulos atuais para o catálogo.
# Crie a conta em themoviedb.org → Configurações → API: serve a "API Read Access Token"
# (a longa) ou a "API Key" (32 caracteres). Sem isto, o cadastro segue manual.
# TV_TMDB_TOKEN=
# TV_TMDB_IDIOMA=pt-BR

# ---- Conversão automática das versões menores ----
# Caminho do ffmpeg, se não estiver no PATH
# TV_FFMPEG=ffmpeg
# Velocidade x tamanho do arquivo: ultrafast, veryfast, medium, slow
# TV_CONVERSAO_PRESET=veryfast
# Qualidade da imagem: 18 (quase sem perda, arquivo grande) a 28 (menor e mais fraco)
# TV_CONVERSAO_CRF=23
