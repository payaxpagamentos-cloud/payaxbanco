<?xml version="1.0" encoding="UTF-8"?>
<!--
  PLAY TV — app para Samsung Smart TV (Tizen).
  Empacote com o Tizen Studio: o app abre o servidor configurado em config.js.
  Troque o id do pacote (xxxxxxxxxx) pelo id que o Samsung Seller Portal gerar para vocês.
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://playtv.com.br/playtv" version="1.0.0" viewmodes="maximized">
  <tizen:application id="PLAYTV0001.PlayTV" package="PLAYTV0001" required_version="6.0"/>
  <name>PLAY TV</name>
  <description>Canais de TV ao vivo, filmes e séries.</description>
  <author email="contato@playtv.com.br">PLAY TV</author>
  <icon src="icon.png"/>
  <content src="index.html"/>

  <!-- A TV precisa de internet e de navegar até o servidor da PLAY TV. -->
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>*</tizen:allow-navigation>

  <!-- App de TV: tela cheia, paisagem, sem barra de navegação. -->
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
  <tizen:metadata key="http://samsung.com/tv/metadata/use.hosted.app" value="true"/>
  <tizen:metadata key="http://samsung.com/tv/metadata/prelaunch.support" value="true"/>
</widget>
