# Copie para .env e ajuste. Em produção (NODE_ENV=production), TAXI_SECRET e TAXI_ADMIN_SENHA são obrigatórios.
PORT=3200
TAXI_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
TAXI_ADMIN_EMAIL=admin@apptaxi.com.br
TAXI_ADMIN_SENHA=troque-esta-senha
# TAXI_DB=./data/taxi.db
# Centro do mapa (lat,lng) e camada de mapa
# TAXI_MAPA_CENTRO=-23.5505,-46.6333
# TAXI_MAPA_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Busca de endereços (vazio desliga; os pontos são marcados no mapa)
# TAXI_GEOCODER_URL=https://nominatim.openstreetmap.org
# TAXI_GEOCODER_CONTATO=contato@suaempresa.com.br
# Atrás de proxy reverso (nginx etc.)
# TAXI_TRUST_PROXY=loopback
