{
  "name": "app-taxi",
  "version": "1.0.0",
  "description": "APP Táxi — app do passageiro, app do motorista, painel da central, pagamentos e repasses.",
  "main": "server/index.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
