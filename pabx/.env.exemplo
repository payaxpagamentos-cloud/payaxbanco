# Copie para .env e ajuste. Em produção (NODE_ENV=production), PABX_SECRET e PABX_ADMIN_SENHA são obrigatórios.
PORT=3300
# Endereço do painel: https://SEU-DOMINIO/pabx/  (vazio = raiz do domínio)
PABX_BASE_PATH=/pabx
PABX_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
# Master criado no primeiro acesso
PABX_ADMIN_NOME=Master
PABX_ADMIN_EMAIL=master@pabx.com.br
PABX_ADMIN_SENHA=troque-esta-senha
# PABX_DB=./data/pabx.db
# Fuso das datas do dashboard e dos relatórios
# PABX_FUSO=America/Sao_Paulo
# Atrás de proxy reverso (nginx etc.)
# PABX_TRUST_PROXY=loopback
