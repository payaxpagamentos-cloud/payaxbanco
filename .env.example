# ===== Banqueiro PAY AX — configuração de produção =====
# Copie para .env e preencha. NUNCA versione o arquivo .env.

# Domínios (DNS apontando para este servidor)
DOMINIO_CLIENTES=internetbanking.payax.com.br
DOMINIO_EQUIPE=banqueiro.payax.com.br

# Segredos obrigatórios. Gere cada um com: openssl rand -hex 32
PAYAX_SECRET=
# PAYAX_PEPPER nunca pode mudar depois de criado: trocar invalida todas as senhas de clientes.
PAYAX_PEPPER=

# Administrador criado no primeiro start (mínimo 12 caracteres; troque depois do primeiro acesso)
PAYAX_ADMIN_EMAIL=admin@payax.com.br
PAYAX_ADMIN_NOME=Administrador PAY AX
PAYAX_ADMIN_SENHA=

# Operação
PAYAX_AGENCIA=0001
PAYAX_LIMITE_OPERADOR=5000000
PAYAX_FUSO=-3 hours
PAYAX_LIMITE_LOGIN=10

# Bradesco (conta PJ da PAY AX). Use "simulador" até receber as credenciais.
BRADESCO_MODO=simulador
BRADESCO_TOKEN_URL=
BRADESCO_PIX_BASE_URL=
BRADESCO_CLIENT_ID=
BRADESCO_CLIENT_SECRET=
# Certificado e-CNPJ: coloque o .pfx no volume de dados (ex.: /app/data/certificado.pfx)
BRADESCO_CERT_PFX=
BRADESCO_CERT_SENHA=
BRADESCO_CHAVE_PIX=
BRADESCO_NOME_RECEBEDOR=PAY AX
BRADESCO_CIDADE_RECEBEDOR=SAO PAULO
BRADESCO_WEBHOOK_TOKEN=
