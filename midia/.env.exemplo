# Copie para .env e ajuste. Em produção (NODE_ENV=production), MIDIA_SECRET e MIDIA_ADMIN_SENHA são obrigatórios.
PORT=3600
# Endereço do painel: https://vaimidia.com.br/midia/  (vazio = raiz do domínio). O player das TVs fica em <endereço>/tv/
MIDIA_BASE_PATH=/midia
# Site institucional (pasta site/) na raiz do domínio e em <base>/site/. 0 desliga (para hospedar o site separado).
MIDIA_SITE=1
MIDIA_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
# Master criado no primeiro acesso
MIDIA_ADMIN_NOME=Master
MIDIA_ADMIN_EMAIL=master@midia.com.br
MIDIA_ADMIN_SENHA=troque-esta-senha
# Banco e arquivos das mídias (vídeos e imagens ficam fora da pasta pública)
# MIDIA_DB=./data/midia.db
# MIDIA_ARQUIVOS=./data/arquivos
# Tamanho máximo de um criativo enviado, em MB
# MIDIA_MAX_MB=200
# Fuso usado na programação (dias e horários das campanhas) e nos relatórios
# MIDIA_FUSO=America/Sao_Paulo
# Atrás de proxy reverso (nginx etc.)
# MIDIA_TRUST_PROXY=loopback
# Tentativas de login por minuto, por IP (vale também para "esqueci minha senha")
# MIDIA_LIMITE_LOGIN=10

# Endereço público do painel, usado nos links dos e-mails
# MIDIA_URL=https://vaimidia.com.br/midia

# Backup: cópia do banco a cada N horas, guardando as N mais recentes
# MIDIA_BACKUPS=./data/backups
# MIDIA_BACKUP_HORAS=24
# MIDIA_BACKUP_MANTER=30
# Espelho dos arquivos das mídias (outro disco ou volume). Sem isso, o backup guarda só o banco.
# MIDIA_ESPELHO=/mnt/backup/midia-arquivos

# ---------------------------------------------------------------------------
# CAIXA DE ENTRADA DO CRM: o servidor de e-mail da própria plataforma (RECEBER)
# ---------------------------------------------------------------------------
# Com domínio preenchido, o sistema abre um servidor SMTP e passa a receber as mensagens endereçadas a
# ele — elas caem no CRM, em CRM › E-mail, ligadas ao lead de quem escreveu. Vazio = desligado.
# ANTES de ligar, leia a seção "Caixa de entrada do CRM" do README: o domínio precisa de registro MX
# apontando para esta máquina, IP fixo, porta 25 liberada pelo provedor e DNS reverso.
# MIDIA_EMAIL_DOMINIOS=vaimidia.com.br
# Nome desta máquina como servidor de e-mail: é o que vai no registro MX e no DNS reverso do IP.
# MIDIA_EMAIL_NOME=mail.vaimidia.com.br
# Porta de escuta (25 é a padrão da internet; abaixo de 1024 exige permissão — veja o README)
# MIDIA_EMAIL_PORTA=25
# MIDIA_EMAIL_HOST=0.0.0.0
# Tamanho máximo de uma mensagem recebida, em MB
# MIDIA_EMAIL_MAX_MB=10
# Onde ficam as mensagens originais (.eml)
# MIDIA_EMAIL_PASTA=./data/emails

# Assinatura DKIM do que SAI (sem ela, provedor grande costuma jogar no spam).
# A chave pública vai num registro TXT em <seletor>._domainkey.<domínio>
# MIDIA_DKIM_DOMINIO=vaimidia.com.br
# MIDIA_DKIM_SELETOR=vaimidia
# MIDIA_DKIM_CHAVE=/etc/vaimidia/dkim.pem

# Avisos por e-mail (tela fora do ar, fatura vencida, fila de aprovação parada) e recuperação de senha.
# Sem MIDIA_SMTP_HOST, o envio fica desligado e o painel avisa.
# MIDIA_SMTP_HOST=smtp.seuprovedor.com.br
# MIDIA_SMTP_PORTA=587
# MIDIA_SMTP_SEGURO=0
# MIDIA_SMTP_USUARIO=avisos@vaimidia.com.br
# MIDIA_SMTP_SENHA=
# MIDIA_SMTP_DE=Vai Mídia <nao-responda@vaimidia.com.br>
